# ─────────────────────────────────────────────────────────────────────────
# AI Operations Command Center — environment configuration
#
# Copy this file to .env.local and fill in real values. NEVER commit
# .env.local (it is gitignored). No value in this file is real — every
# entry below is a placeholder.
# ─────────────────────────────────────────────────────────────────────────

# ── Agent adapter selection ────────────────────────────────────────────────
# "openclaw" = real reasoning via an OpenClaw Gateway (production/demo path).
# "mock"     = deterministic local fallback, clearly labeled MOCK MODE
#              everywhere it appears. Development/testing only — never use
#              mock mode to claim a working OpenClaw integration.
AGENT_ADAPTER=mock

# ── OpenClaw Gateway (server-side only; required when AGENT_ADAPTER=openclaw) ─
# The Gateway is a separate process you run (see `openclaw onboard`) or a
# remote Gateway you have network access to. Never exposed to the browser.
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-your-openclaw-gateway-token

# ── n8n adapter selection (server-side only) ────────────────────────────────
# "http" = dispatch to a real n8n webhook. "mock" (default) = run the same
# validate -> call GHL -> respond contract in-process, so the pipeline is
# testable without a live n8n instance. See lib/n8n/client.ts.
N8N_ADAPTER=mock
# Required when N8N_ADAPTER=http. Base URL of your n8n instance.
N8N_BASE_URL=https://your-instance.app.n8n.cloud
# Shared secret sent as a header on every webhook call and validated by each
# n8n workflow's webhook node (see n8n/workflows/). GoHighLevel credentials
# in the real n8n deployment live only inside n8n's own credential store.
N8N_WEBHOOK_SECRET=replace-with-a-long-random-shared-secret

# ── GoHighLevel adapter selection (server-side only) ────────────────────────
# "real" = call the live GoHighLevel v2 API. "mock" (default) = deterministic
# fake responses, clearly labeled MOCK MODE. Presence of a token alone does
# NOT switch modes — GHL_ADAPTER must be explicitly set to "real" so a demo
# never accidentally hits a real CRM. See lib/ghl/client.ts.
GHL_ADAPTER=mock
# Required when GHL_ADAPTER=real. A GoHighLevel Private Integration token,
# scoped to one location/sub-account. Never print or log this value.
GHL_PRIVATE_INTEGRATION_TOKEN=replace-with-your-ghl-private-integration-token
# Verified live API host — do not change unless GoHighLevel documents a new
# one. Confirmed by direct request: an unauthenticated call to this host
# returns GHL's own {"message":"version header was not found."} error, not
# a generic 404.
GHL_API_BASE_URL=https://services.leadconnectorhq.com
# Verified required header value — confirmed by direct request: omitting it
# is rejected before auth is even checked. GoHighLevel may revise this
# date-stamped version string over time; check their docs if calls start
# failing with a version-related error.
GHL_API_VERSION=2021-07-28

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser by design —
# NEXT_PUBLIC_ vars are bundled into client code, but the anon key's only
# power is what Row Level Security grants it. As of Phase 2, RLS grants the
# anon role zero access on every table (see the migration), so this key
# currently cannot read or write anything even though it is public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Service role key bypasses Row Level Security entirely — full database
# access. Server-side only. Must never be prefixed NEXT_PUBLIC_, never sent
# to the browser, never committed. This app reads it only from
# lib/supabase/server.ts, which is guarded by the `server-only` package so
# an accidental client-side import fails at build time.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
