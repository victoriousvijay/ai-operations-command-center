# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# vercel
.vercel

# env files — never commit real secrets
.env
.env.local
.env.*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea

# Claude Code local settings — accumulates a per-session tool-permission
# allowlist that can end up echoing secrets used in Bash/tool calls
# (e.g. curl commands run against real API tokens during setup).
.claude/settings.local.json
.env*
