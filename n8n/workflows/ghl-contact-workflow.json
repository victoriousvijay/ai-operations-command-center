        "jsCode": "const item = $input.first().json;\nconst body = item.body ?? item;\nconst requestId = body.requestId;\nconst actionId = body.actionId;\nconst actionType = body.actionType;\nconst payload = body.payload;\n\nif (!requestId || !actionId || !actionType || !payload) {\n  throw new Error(\"Missing requestId, actionId, actionType, or payload.\");\n}\nif (actionType !== \"GET_CONTACT\" && actionType !== \"UPDATE_CONTACT\") {\n  throw new Error(\"ghl-contact-workflow does not handle action type \" + actionType);\n}\nif (!payload.contactId) {\n  throw new Error(\"payload.contactId is required.\");\n}\n\nreturn [{ json: { requestId: requestId, actionId: actionId, actionType: actionType, payload: payload } }];"
