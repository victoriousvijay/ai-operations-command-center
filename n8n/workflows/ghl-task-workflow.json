    {
      "id": "d6939cf8-5bcc-4fb7-9a38-432cc43e0c65",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 96],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst body = item.body ?? item;\nconst requestId = body.requestId;\nconst actionId = body.actionId;\nconst actionType = body.actionType;\nconst payload = body.payload;\n\nif (!requestId || !actionId || !actionType || !payload) {\n  throw new Error(\"Missing requestId, actionId, actionType, or payload.\");\n}\nif (actionType !== \"CREATE_TASK\" && actionType !== \"ADD_NOTE\") {\n  throw new Error(\"ghl-task-workflow does not handle action type \" + actionType);\n}\nif (!payload.contactId) {\n  throw new Error(\"payload.contactId is required.\");\n}\nif (actionType === \"CREATE_TASK\" && (!payload.title || !payload.dueDate)) {\n  throw new Error(\"payload.title and payload.dueDate are required for CREATE_TASK.\");\n}\nif (actionType === \"ADD_NOTE\" && !payload.body) {\n  throw new Error(\"payload.body is required for ADD_NOTE.\");\n}\n\nreturn [{ json: { requestId: requestId, actionId: actionId, actionType: actionType, payload: payload } }];"
      }
    },
    {
      "id": "55b544fd-5298-4b57-9853-326578b8c4aa",
      "name": "Is CREATE_TASK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 96],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.actionType }}", "rightValue": "CREATE_TASK", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "342330bd-286f-4a2f-81ed-6ee6052b3716",
      "name": "POST Task (GHL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [672, 0],
      "parameters": {
        "method": "POST",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $json.payload.contactId }}/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Version", "value": "2021-07-28" }] },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { title: $json.payload.title, body: $json.payload.body, dueDate: $json.payload.dueDate, completed: false, assignedTo: $json.payload.assignedTo } }}"
